1000 REM *********************************************************************
1020 REM ****************** NOMOGRAMMI DI ALLINEAMENTO ***********************
1040 REM ****** by M Besozzi & PP Bianchi - Versione 1.2 - [05/03/88] ********
1060 REM *********************************************************************
1070 ON ERROR GOTO 5000
1080 KEY OFF
1090 FOR I%=1 TO 10:KEY I%,"":NEXT I%
1100 DEFDBL A,Z
1110 SISTEMACOMPONENTE$="S--CORTISOLO":VECCHIEUNITA$="ug/dL":NUOVEUNITA$="nmol/L":FATTORE=27.6
1120 LIMITEINFERIOREV=0:LIMITESUPERIOREV=50:NUMERODECIMALI=0
1130 LIMITEINFERIORERIFV=10:LIMITESUPERIORERIFV=20
1132 GRANDEZZAV$="cms.":GRANDEZZASI$="cst."
1133 NUMERODIVISIONIV=5:NUMERODIVISIONISI=5
1140 PIXELX=50:PIXELY=320:STARTX=200:STARTY=376
1150 CLS
1160 LOCATE 1,1:PRINT"********************************************************************************"
1170 LOCATE 2,1:PRINT"************************** NOMOGRAMMI DI ALLINEAMENTO **************************"
1180 LOCATE 3,1:PRINT"*********** by M Besozzi & PP Bianchi - Versione 1.2 - [05/03/88] **************"
1190 LOCATE 4,1:PRINT"****** Copyright (C) 1988 Societa' Italiana di Biochimica Clinica (SIBioC) *****"
1194 LOCATE 5,1:PRINT"********************************************************************************"
1200 LOCATE 6,1:PRINT"Parametro                     Valore attuale                 Nuovo valore"
1210 LOCATE 7,1:PRINT"------------------      -------------------------      -------------------------"
1220 LOCATE 8,1:PRINT TAB(1);"Sistema-componente";TAB(25);SISTEMACOMPONENTE$
1230 LOCATE 9,1:PRINT TAB(1);"Vecchie unita' (V)";TAB(25);VECCHIEUNITA$
1240 LOCATE 10,1:PRINT TAB(1);"Nuove unita' (SI)";TAB(25);NUOVEUNITA$
1250 LOCATE 11,1:PRINT TAB(1);"Fattore  V -> SI";TAB(24);FATTORE
1260 LOCATE 12,1:PRINT TAB(1);"Numero decimali";TAB(24);NUMERODECIMALI
1270 LOCATE 13,1:PRINT TAB(1);"Limite inferiore V";TAB(24);LIMITEINFERIOREV
1280 LOCATE 14,1:PRINT TAB(1);"Limite superiore V";TAB(24);LIMITESUPERIOREV
1290 LOCATE 15,1:PRINT TAB(1);"Limite inferiore SI";TAB(24);LIMITEINFERIORESI
1300 LOCATE 16,1:PRINT TAB(1);"Limite superiore SI";TAB(24);LIMITESUPERIORESI
1310 LOCATE 17,1:PRINT TAB(1);"Limite inferiore RIFV";TAB(24);LIMITEINFERIORERIFV
1316 LOCATE 18,1:PRINT TAB(1);"Limite superiore RIFV";TAB(24);LIMITESUPERIORERIFV
1320 REM INTRODUZIONE PARAMETRI **********************************************
1322 LOCATE 19,1:PRINT TAB(1);"Grandezza V";TAB(25);GRANDEZZAV$
1324 LOCATE 20,1:PRINT TAB(1);"Grandezza SI";TAB(25);GRANDEZZASI$
1325 LOCATE 21,1:PRINT TAB(1);"# divisioni scala V";TAB(24);NUMERODIVISIONIV
1328 LOCATE 22,1:PRINT TAB(1);"# divisioni scala SI";TAB(24);NUMERODIVISIONISI
1330 LOCATE 8,56:INPUT"",A$
1340 IF A$="" THEN LOCATE 8,56:PRINT SISTEMACOMPONENTE$:GOTO 1360
1350 SISTEMACOMPONENTE$=LEFT$(A$,40)
1360 LOCATE 9,56:INPUT"",A$
1370 IF A$="" THEN LOCATE 9,56:PRINT VECCHIEUNITA$:GOTO 1390
1380 VECCHIEUNITA$=LEFT$(A$,10)
1390 LOCATE 10,56:INPUT"",A$
1400 IF A$="" THEN LOCATE 10,56:PRINT NUOVEUNITA$:GOTO 1420
1410 NUOVEUNITA$=LEFT$(A$,10)
1420 LOCATE 11,56:INPUT"",A$
1430 IF A$="" THEN LOCATE 11,55:PRINT FATTORE:GOTO 1450
1440 FATTORE=VAL(A$)
1450 LOCATE 12,56:INPUT"",A$
1460 IF A$="" THEN LOCATE 12,55:PRINT NUMERODECIMALI:GOTO 1480
1470 NUMERODECIMALI=VAL(A$)
1480 IF NUMERODECIMALI=0 THEN ND=1
1490 IF NUMERODECIMALI=1 THEN ND=10
1500 IF NUMERODECIMALI=2 THEN ND=100
1510 LOCATE 13,56:INPUT"",A$
1520 IF A$="" THEN LOCATE 13,55:PRINT LIMITEINFERIOREV:GOTO 1540
1530 LIMITEINFERIOREV=VAL(A$)
1540 LOCATE 14,56:INPUT"",A$
1550 IF A$="" THEN LOCATE 14,55:PRINT LIMITESUPERIOREV:GOTO 1570
1560 LIMITESUPERIOREV=VAL(A$)
1570 LIMITEINFERIORESI=INT(LIMITEINFERIOREV*FATTORE*ND+.5)/ND
1580 LOCATE 15,56:INPUT"",A$
1590 IF A$="" THEN LOCATE 15,55:PRINT LIMITEINFERIORESI:GOTO 1610
1600 LIMITEINFERIORESI=VAL(A$)
1610 LIMITESUPERIORESI=INT(LIMITESUPERIOREV*FATTORE*ND+.5)/ND
1620 LOCATE 16,56:INPUT"",A$
1630 IF A$="" THEN LOCATE 16,55:PRINT LIMITESUPERIORESI:GOTO 1650
1640 LIMITESUPERIORESI=VAL(A$)
1650 LOCATE 17,56:INPUT"",A$
1660 IF A$="" THEN LOCATE 17,55:PRINT LIMITEINFERIORERIFV:GOTO 1680
1670 LIMITEINFERIORERIFV=VAL(A$)
1680 LOCATE 18,56:INPUT"",A$
1690 IF A$="" THEN LOCATE 18,55:PRINT LIMITESUPERIORERIFV:GOTO 1701
1700 LIMITESUPERIORERIFV=VAL(A$)
1701 LOCATE 19,56:INPUT"",A$
1702 IF A$="" THEN LOCATE 19,56:PRINT GRANDEZZAV$:GOTO 1704
1703 GRANDEZZAV$=LEFT$(A$,40)
1704 LOCATE 20,56:INPUT"",A$
1705 IF A$="" THEN LOCATE 20,56:PRINT GRANDEZZASI$:GOTO 1710
1706 GRANDEZZASI$=LEFT$(A$,10)
1710 LOCATE 21,56:INPUT"",A$
1711 IF A$="" THEN LOCATE 21,55:PRINT NUMERODIVISIONIV:GOTO 1715
1712 NUMERODIVISIONIV=VAL(A$)
1715 LOCATE 22,56:INPUT"",A$
1716 IF A$="" THEN LOCATE 22,55:PRINT NUMERODIVISIONISI:GOTO 1719
1718 NUMERODIVISIONISI=VAL(A$)
1719 LOCATE 24,1:PRINT"(premere <RETURN> per continuare) ";:A$=INPUT$(1)
1720 IF ASC(A$)=13 THEN GOTO 1740
1730 BEEP:GOTO 1710
1740 REM SCALA NELLE UNITA' TRADIZIONALI *************************************
1742 SCREEN 13
1750 LINE(STARTX-2,STARTY)-(STARTX-2,STARTY-PIXELY)
1760 PASSO=PIXELY/NUMERODIVISIONIV
1770 PIXELVERT=STARTY
1780 FOR I%=1 TO NUMERODIVISIONIV+1
1790 LINE(STARTX-2-PIXELX/2,PIXELVERT)-(STARTX-2,PIXELVERT)
1800 PIXELVERT=PIXELVERT-PASSO
1810 NEXT I%
1820 PASSO=PIXELY/(NUMERODIVISIONIV*2)
1830 PIXELVERT=STARTY
1840 FOR I%=1 TO NUMERODIVISIONIV*2+1
1850 LINE(STARTX-2-PIXELX/4,PIXELVERT)-(STARTX-2,PIXELVERT)
1860 PIXELVERT=PIXELVERT-PASSO
1870 NEXT I%
1880 PASSO=PIXELY/(NUMERODIVISIONIV*10)
1890 PIXELVERT=STARTY
1900 FOR I%=1 TO NUMERODIVISIONIV*10+1
1910 LINE(STARTX-2-PIXELX/8,PIXELVERT)-(STARTX-2,PIXELVERT)
1920 PIXELVERT=PIXELVERT-PASSO
1930 NEXT I%
1940 PASSO=(LIMITESUPERIOREV-LIMITEINFERIOREV)/NUMERODIVISIONIV
1950 VALORE=LIMITEINFERIOREV
1960 VER=24
1970 FOR I%=1 TO NUMERODIVISIONIV+1
1980 LOCATE VER,20-LEN(STR$(VALORE))
1990 PRINT VALORE;
2000 VALORE=VALORE+PASSO
2010 VER=VER-4*(5/NUMERODIVISIONIV)
2020 NEXT I%
2022 REM SCALA NELLE UNITA' SI ***********************************************
2030 IF LIMITEINFERIORESI=0 AND LIMITEINFERIOREV=0 THEN GOTO 2050
2040 STARTY=STARTY-PIXELY*(((LIMITEINFERIORESI/FATTORE)-LIMITEINFERIOREV)/(LIMITESUPERIOREV-LIMITEINFERIOREV))
2050 PIXELY=PIXELY*(((LIMITESUPERIORESI-LIMITEINFERIORESI)/FATTORE)/(LIMITESUPERIOREV-LIMITEINFERIOREV))
2060 LINE(STARTX+2,STARTY)-(STARTX+2,STARTY-PIXELY)
2070 PASSO=PIXELY/NUMERODIVISIONISI
2080 PIXELVERT=STARTY
2090 FOR I%=1 TO NUMERODIVISIONISI+1
2100 LINE(STARTX+2+PIXELX/2,PIXELVERT)-(STARTX+2,PIXELVERT)
2110 PIXELVERT=PIXELVERT-PASSO
2120 NEXT I%
2130 PASSO=PIXELY/(NUMERODIVISIONISI*2)
2140 PIXELVERT=STARTY
2150 FOR I%=1 TO NUMERODIVISIONISI*2+1
2160 LINE(STARTX+2+PIXELX/4,PIXELVERT)-(STARTX+2,PIXELVERT)
2170 PIXELVERT=PIXELVERT-PASSO
2180 NEXT I%
2190 PASSO=PIXELY/(NUMERODIVISIONISI*10)
2200 PIXELVERT=STARTY
2210 FOR I%=1 TO NUMERODIVISIONISI*10+1
2220 LINE(STARTX+2+PIXELX/8,PIXELVERT)-(STARTX+2,PIXELVERT)
2230 PIXELVERT=PIXELVERT-PASSO
2240 NEXT I%
2250 PASSO=(LIMITESUPERIORESI-LIMITEINFERIORESI)/NUMERODIVISIONISI
2260 VALORE=LIMITEINFERIORESI
2270 VER=STARTY/16
2280 INCREM=PIXELY/16.6666/NUMERODIVISIONISI
2290 FOR I%=1 TO NUMERODIVISIONISI+1
2300 LOCATE VER,31
2310 PRINT VALORE;
2320 VALORE=VALORE+PASSO
2330 VER=VER-INCREM
2340 NEXT I%
2344 PIXELX=50:PIXELY=320:STARTX=200:STARTY=376
2350 IF LIMITEINFERIORERIFV=0 AND LIMITESUPERIORERIFV=0 THEN GOTO 2430
2360 STARTY=STARTY-PIXELY*((LIMITEINFERIORERIFV-LIMITEINFERIOREV)/(LIMITESUPERIOREV-LIMITEINFERIOREV))
2370 PIXELY=PIXELY*((LIMITESUPERIORERIFV-LIMITEINFERIORERIFV)/(LIMITESUPERIOREV-LIMITEINFERIOREV))
2380 FOR X=STARTX-.8*PIXELX TO STARTX+.8*PIXELX STEP 4
2390 FOR Y=STARTY TO STARTY-PIXELY STEP -4
2400 PSET(X,Y)
2410 NEXT Y
2420 NEXT X
2428 LOCATE 1,10:PRINT GRANDEZZAV$
2430 LOCATE 2,10:PRINT VECCHIEUNITA$
2440 LOCATE 1,40:PRINT GRANDEZZASI$
2444 LOCATE 2,40:PRINT NUOVEUNITA$
2450 LOCATE 16,60-LEN(SISTEMACOMPONENTE$)/2:PRINT SISTEMACOMPONENTE$;
2460 LOCATE 23,1:PRINT"------>"
2470 LOCATE 24,1:PRINT"x";FATTORE;
2480 LOCATE 23,50:PRINT"<------"
2490 LOCATE 24,50:PRINT"x";INT((1/FATTORE)*10000+.5)/10000;
2500 A$=INPUT$(1)
2510 CLS
2520 PIXELX=50:PIXELY=320:STARTX=200:STARTY=376
2530 LOCATE 24,1:PRINT"(<RET> per continuare, <ESC> per terminare) ";:A$=INPUT$(1)
2540 IF ASC(A$)=13 THEN SCREEN 0:GOTO 1160
2550 IF ASC(A$)=27 THEN CLS:SYSTEM
2560 BEEP:GOTO 2530
5000 REM *********************************************************************
5010 REM ERRORI **************************************************************
5020 REM *********************************************************************
5030 BEEP
5040 CLOSE
5050 MSG$="consultare il manuale del BASIC"
5060 IF ERR=27 THEN MSG$="stampante spenta o carta terminata"
5070 IF ERR=53 THEN MSG$="non esiste un file con questo nome"
5080 IF ERR=57 THEN MSG$="non posso leggere/scrivere il file"
5090 IF ERR=61 THEN MSG$="spazio su dischetto esaurito"
5100 IF ERR=64 THEN MSG$="nome file non ammesso"
5110 IF ERR=67 THEN MSG$="troppi files nella directory"
5120 IF ERR=70 THEN MSG$="dischetto protetto da scrittura"
5130 IF ERR=71 THEN MSG$="drive aperto o senza dischetto"
5140 IF ERR=72 THEN MSG$="dischetto danneggiato"
5150 IF ERR=76 THEN MSG$="nome file inadeguato"
5160 LOCATE 23,1:COLOR 0,7:PRINT"Errore ";ERR;": ";MSG$;:COLOR 7,0
5170 LOCATE 24,1:COLOR 0,7:PRINT"(premere <RETURN> per continuare) ";:COLOR 7,0:A$=INPUT$(1):IF ASC(A$)<>13 THEN 5170 ELSE 5180
5180 RESUME 1110
5190 REM *********************************************************************
5200 REM FINE LISTATO ********************************************************
5210 REM *********************************************************************
