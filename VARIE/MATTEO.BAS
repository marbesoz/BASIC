10 CLS
20 DIM TEMPO(1000), TASTO(1000), VOLTETASTO(3), TEMPOTOTALE(3), POSIZIONE$(3)
30 I = 0
40 NUMDATI = 0
72 POSIZIONE$(1) = "pronazione  (f1)"
74 POSIZIONE$(2) = "normale     (f2)"
80 POSIZIONE$(3) = "supinazione (f3)"
90 ON KEY(1) GOSUB 1000
100 KEY(1) ON
110 ON KEY(2) GOSUB 2000
120 KEY(2) ON
130 ON KEY(3) GOSUB 3000
140 KEY(3) ON
150 ON KEY(4) GOSUB 4000
160 KEY(4) ON
170 PRINT "f1=pronazione, f2=posizione normale, f3=supinazione, f4=termina"
180 PRINT
190 PRINT "PREMERE <RETURN> PER AVVIARE IL TIMER"
200 A$ = INPUT$(1)
210 IF ASC(A$) = 13 THEN GOTO 218
212 BEEP
214 GOTO 200
218 PRINT
220 PRINT "INIZIO TEMPORIZZAZIONE...."
230 I = I + .01
240 GOTO 230
1000 REM E' STATO PREMUTO IL TASTO 1
1001 NUMDATI = NUMDATI + 1
1010 VOLTETASTO(1) = VOLTETASTO(1) + 1
1020 TEMPO(NUMDATI) = I
1030 TASTO(NUMDATI) = 1
1999 RETURN 230
2000 REM E' STATO PREMUTO IL TASTO 2
2001 NUMDATI = NUMDATI + 1
2010 VOLTETASTO(2) = VOLTETASTO(2) + 1
2020 TEMPO(NUMDATI) = I
2030 TASTO(NUMDATI) = 2
2999 RETURN 230
3000 REM E' STATO PREMUTO IL TASTO 3
3001 NUMDATI = NUMDATI + 1
3010 VOLTETASTO(3) = VOLTETASTO(3) + 1
3020 TEMPO(NUMDATI) = I
3030 TASTO(NUMDATI) = 3
3999 RETURN 230
4000 REM STAMPA I RISULTATI ED ESCE
4010 PRINT
4020 CLS
4030 PRINT "Progressivo              Tempo                  Posizione"
4040 PRINT "-----------           ------------          ---------------------"
4050 FOR J = 1 TO NUMDATI
4060 PRINT TAB(4); J; TAB(24); TEMPO(J); TAB(48); POSIZIONE$(TASTO(J))
4070 NEXT J
4080 FOR J = 1 TO NUMDATI - 1
4090 TEMPOTOTALE(TASTO(J)) = TEMPOTOTALE(TASTO(J)) + (TEMPO(J + 1) - TEMPO(J))
4100 NEXT J
4110 PRINT
4130 PRINT "Numero                  Tempo                  Posizione"
4140 PRINT "-----------           ------------          ---------------------"
4150 FOR K = 1 TO 3
4160 PRINT TAB(4); VOLTETASTO(K); TAB(24); TEMPOTOTALE(K); TAB(48); POSIZIONE$(K)
4170 NEXT K
4999 RETURN 9999
9999 END

