10  'ESEMPIO DI ORDINAMENTO DI 32 NUMERI CON IL METODO RIPPLE (RIPPLE.BAS)
15 '********************************************************
20 ' PREPARAZIONE DEL VETTORE CON 32 NUMERI DA ORDINARE.
30 CLS
40 D=32
50 DIM NUMERO(D)
60 FOR I=1 TO D
70 READ NUMERO(I)
80 NEXT I
85 '********************************************************
90 PRINT "INIZIO ORDINAMENTO : ";TIME$
100 ELEMENTI = D
110 INVERSIONI = 0
120 FOR I =1 TO ELEMENTI - 1
130     C= C+1 : ' CONTATORE DEI CONFRONTI
140     IF NUMERO(I) > NUMERO(I+1) THEN SWAP NUMERO(I),NUMERO(I+1) :INVERSIONI=1                                                                   :S=S+1
150 NEXT I
160 IF INVERSIONI = 1 THEN ELEMENTI = ELEMENTI - 1
170 IF INVERSIONI = 1 THEN GOTO 110
180 PRINT "FINE ORDINAMENTO   : ";TIME$
185 '********************************************************
190 PRINT "CONFRONTI  ";C;TAB(40) "SCAMBI  ";S
200 PRINT " "
210 PRINT "SEQUENZA DEI NUMERI DOPO L'ORDINAMENTO  "
220 FOR T=1 TO D
230 PRINT NUMERO(T);" ";
240 NEXT T
250 END
255 '********************************************************
300 DATA 450,321,178,190,4,256,54,435,43,89,350,210,5,432,48,376,1,34,277,444,9,222,20,50,333,6,454,111,100,200,400,32
