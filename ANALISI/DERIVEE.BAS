5060  FOR I = 0 TO N: GOSUB 8000: NEXT I
5070  IF B(0) <  > 0 THEN  PRINT "B0 DEVE ESSERE NULLO": GOTO 5490
5080  GOTO 5140
5090  PRINT : PRINT "INTRODUCETE I COEFFICIENTI DELLO S.F. DI G:"
