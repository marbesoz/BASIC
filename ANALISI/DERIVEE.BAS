8040  FOR H = 1 TO I:A(I) = A(I) / H: NEXT H
8050 B(I) = 0
8060  IF I <  > 2 * M THEN 8090
8070 B(I) = ( - 1) ^ M
8080  FOR H = 1 TO I:B(I) = B(I) / H: NEXT H
8090  RETURN 
9000 AB = X:AC =  INT (X):P = AC
9010 Q = 1:AD = 1:AF = 0: GOTO 9050
