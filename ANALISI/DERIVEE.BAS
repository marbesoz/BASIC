2080  PRINT : PRINT "A0="; FN F(X)
2090  FOR N = 1 TO M
2100  GOSUB 2500
2110  FOR K = 1 TO N:T = T / K: NEXT K
2120  PRINT "A";N;"=";T
2130  NEXT N
2140  PRINT : INPUT "VOLETE RIUTILIZZARE IL PROGRAMMA:";Z$
2150  IF Z$ = "S" THEN 2000
2160  GOTO 100
2500 H = .1
2510  RESTORE : FOR K = 1 TO N: FOR J = 0 TO 6: READ U(J): NEXT J: NEXT K
2520 T = 0:P = ( - 1) ^ N
2530  FOR K = 1 TO U(0)
2540 T = T + U(K) * (( FN F(X + K * H) -  FN F(X)) + P * ( FN F(X - K * H) -  FN F(X)))
2550  NEXT K
2560 T = T / U(6) / (H ^ N)
2570  RETURN 
