1 KEY OFF
10 C = 639:L = 199:PI = 3.1415926536#
20  DIM A(20),B(20),C(20),P(C),AF(20)
100  SCREEN 0:CLS
110  PRINT  TAB( 5);"SERIE DI FOURIER": PRINT 
120  PRINT : PRINT "1- CALCOLO DEI COEFFICIENTI"
130  PRINT : PRINT "2- RAPPRESENTAZIONE DELLO SPETTRO"
140  PRINT : PRINT "3- SINTESI DEL SEGNALE"
150  PRINT : PRINT "4- FINE"
160  PRINT : INPUT "FUNZIONE RICHIESTA:";E
170  ON E GOTO 1000,2000,3000,4000
180  GOTO 160
1000  CLS 
1010  PRINT  TAB( 5);"CALCOLO DEI COEFFICIENTI": PRINT 
1020  PRINT : PRINT "1- DEFINIZIONE DELLA FUNZIONE"
1030  PRINT : PRINT "2- CALCOLO DEI COEFFICIENTI"
1040  PRINT : INPUT "FUNZIONE RICHIESTA:";E
1050  IF E = 1 THEN  LIST 1900 - 1999: END 
1060  GOSUB 1950
1070  PRINT : INPUT "NUMERO DEI TERMINI DA CALCOLARE:";NB: PRINT 
1080  IF NB < 1 OR NB > 20 THEN 1070
1090  INPUT "PRECISIONE (DA 1 A 8):";E: PRINT 
1100  FOR Q = 0 TO NB
1110  PRINT 
1120 N = 0:A =  - T / 2:T2 = T / 2000
1130 X = A: GOSUB 1900:YA = Y *  COS (2 * PI * Q * X / T)
1140 X =  - A: GOSUB 1900:YB = Y *  COS (2 * PI * Q * X / T)
1150 T(0,0) = T * (YA + YB) / 2
1160 N = N + 1:H = T / (2 ^ N)
1170 T(0,N) = (YA + YB) / 2
1180  FOR I = 1 TO (2 ^ N) - 1
1190 X = A + I * H
1200  IF  ABS (X) < T2 THEN X = 0
1210  GOSUB 1900
1220 T(0,N) = T(0,N) + Y *  COS (2 * PI * Q * X / T)
1230  NEXT I
1240 T(0,N) = T(0,N) * H
1250  FOR P = 1 TO N
1260 K = N - P
1270 T(P,K) = ((4 ^ P) * T(P - 1,K + 1) - T(P - 1,K)) / ((4 ^ P) - 1)
1280  NEXT P
1290  IF (N < 4) OR (Q = 8 AND N < 5) OR (Q = 16 AND N < 6) THEN 1160
1300  IF  ABS (T(N,0) - T(N - 1,0)) < 10 ^ ( - E) THEN 1340
1310  IF N < 10 THEN 1160
1320 PR = 1 +  INT ( LOG ( ABS (T(N,0) - T(N -1,0)) * 2 / T) /LOG (10))
1330  IF (-PR <>E) THEN PRINT "LA PRECISIONE PUO' ESSERE AL PIU' DI 1E";PR
1340 A(Q) = T(N,0) * 2 / T
1350  IF  ABS (A(Q)) < 1E-08 THEN A(Q) = 0
1360  IF Q = 0 THEN A(0) = A(0) / 2: PRINT "A0=";A(0): GOTO 1630
1370  PRINT "A";Q;"=";A(Q)
1380 N = 0
1390 X = A: GOSUB 1900:YA = Y *  SIN (2 * PI * Q * X / T)
1400 X =  - A: GOSUB 1900:YB = Y *  SIN (2 * PI * Q * X / T)
1410 T(0,0) = T * (YA + YB) / 2
1420 N = N + 1:H = T / (2 ^ N)
1430 T(0,N) = (YA + YB) / 2
1440  FOR I = 1 TO (2 ^ N) - 1
1450 X = A + I * H
1460  IF  ABS (X) < T2 THEN X = 0
1470  GOSUB 1900
1480 T(0,N) = T(0,N) + Y *  SIN (2 * PI * Q * X / T)
1490  NEXT I
1500 T(0,N) = T(0,N) * H
1510  FOR P = 1 TO N
1520 K = N - P
1530 T(P,K) = ((4 ^ P) * T(P - 1,K + 1) - T(P - 1,K)) / ((4 ^ P) - 1)
1540  NEXT P
1550  IF (N < 4) OR (Q = 8 AND N < 5) OR (Q = 16 AND N < 6) THEN 1420
1560  IF  ABS (T(N,0) - T(N - 1,0)) < 10 ^ ( - E) THEN 1600
1570  IF N < 10 THEN 1420
1580 PR = 1 +  INT ( LOG ( ABS (T(N,0) - T(N - 1,0)) * 2 / T)/LOG (10))
1590  IF(-PR <>E) THEN PRINT "LA PRECISIONE PUO' ESSERE AL PIU' DI 1E";PR
1600 B(Q) = T(N,0) * 2 / T
1610  IF  ABS (B(Q)) < 1E-08 THEN B(Q) = 0
1620  PRINT "B";Q;"=";B(Q)
1630  NEXT Q
1640  CLS 
1650  FOR Q = 0 TO NB
1660  PRINT "A";Q;"=";A(Q);
1670  IF Q = 0 THEN  PRINT : GOTO 1690
1680  PRINT  TAB( 20);"B";Q;"=";B(Q)
1690  IF NB < 11 THEN  PRINT 
1700  NEXT Q
1710  PRINT : INPUT "VOLETE RIUTILIZZARE IL PROGRAMMA:";Z$
1720  IF Z$ = "S" THEN 1000
1730  GOTO 100
1900 Y = 0
1910  IF X >  - PI AND X < 0 THEN Y =  - PI / 4
1920  IF X > 0 AND X < PI THEN Y = PI / 4
1930  RETURN 
1950 T = 2 * PI
1960  RETURN 
2000  CLS 
2010  PRINT  TAB( 5);"RAPPRESENTAZIONE DELLO SPETTRO": PRINT 
2020  PRINT : PRINT "1- IMPIEGO DEI COEFFICIENTI GIA' CALCOLATI"
2030  PRINT 
2040  PRINT : PRINT "2- INTRODUZIONE DEI COEFFICIENTI"
2050  PRINT : INPUT "FUNZIONE RICHIESTA:";E
2060  IF E = 1 THEN 2210
2070  PRINT 
2080  INPUT "NUMERO DI TERMINI";NB
2090  IF NB < 1 OR NB > 20 THEN 2070
2100  PRINT 
2110  INPUT "A0:";A(0)
2120 C(0) =  ABS (A(0))
2130  PRINT 
2140  FOR I = 1 TO NB
2150  PRINT "A";I;
2160  INPUT A(I)
2170  PRINT "B";I;
2180  INPUT B(I)
2190  PRINT 
2200  NEXT I
2210 MX = 0
2220  FOR I = 1 TO NB
2230 C(I) =  SQR (A(I) * A(I) + B(I) * B(I))
2240  IF C(I) > MX THEN MX = C(I)
2250  NEXT I
2260  IF MX = 0 THEN 2070
2270  FOR I = 1 TO NB
2280 C(I) = C(I) / MX * (L - 20)
2290  NEXT I
2300 E =  INT ((C - 20) / (NB + 1))
2310  SCREEN 2
2320 XA = 10:YA = L - 10
2330  LINE (XA,0)- (XA,L)
2340  LINE (XA + (NB + 1) * E,0)- (XA + (NB + 1) * E,L)
2350  LINE (0,YA)- (2 * XA + (NB + 1) * E,YA)
2360  FOR I = 1 TO NB
2370 LG = 3
2380  IF (I / 5) =  INT (I / 5) THEN LG = 6
2390  LINE (XA + I * E,YA)- (XA + I * E,YA + LG)
2400 NEXT I
2410  FOR I = 1 TO 10
2420 LG = 3
2430  IF (I / 5) =  INT (I / 5) THEN LG = 6
2440  LINE (XA,YA - I * (L - 20) / 10) -(XA - LG,YA - I * (L - 20) / 10)
2450 LINE (XA+(NB+1)*E,YA-I*(L-20)/10)-(LG+XA+(NB+1)*E,YA-I*(L-20)/10)
2460  NEXT I
2470  FOR I = 1 TO NB
2480  LINE( XA + I * E,YA)- ( XA + I * E,YA - C(I))
2490  NEXT I
2500  INPUT "VOLETE RIUTILIZZARE IL PROGRAMMA:";Z$
2510  SCREEN 0 
2520  IF Z$ = "S" THEN 2000
2530  GOTO 100
3000  CLS 
3010  PRINT  TAB( 5);"SINTESI DEL SEGNALE": PRINT 
3020  PRINT : PRINT "1- IMPIEGO DEI COEFFICIENTI"
3030  PRINT "   PRECEDENTI"
3040  PRINT : PRINT "2- INTRODUZIONE DEI COEFFICIENTI"
3050  PRINT : INPUT "FUNZIONE RICHIESTA:";E
3060  IF E = 1 THEN 3200
3070  PRINT 
3080  INPUT "NUMERO DI TERMINI";NB
3090  IF NB < 1 OR NB > 20 THEN 3070
3100  PRINT 
3110  INPUT "A0:";A(0)
3120  PRINT 
3130  FOR I = 1 TO NB
3140  PRINT "A";I;
3150  INPUT A(I)
3160  PRINT "B";I;
3170  INPUT B(I)
3180  PRINT 
3190  NEXT I
3200  PRINT : PRINT "CURVE DA STAMPARE :": PRINT 
3210  FOR K = 0 TO NB
3220  PRINT "CURVA NUMERO  ";K;
3230  INPUT K$
3240 AF(K) = 0
3250  IF K$ = "O" THEN AF(K) = 1
3260  NEXT K
3270  SCREEN 2
3280 XA =  INT (C / 2)
3290 YA =  INT (L / 2)
3300  LINE( XA,0)-( XA,L)
3310  LINE( 0,YA)- ( C,YA)
3320 DG =  INT ((C - 5) / 24)
3330 D = 1
3340  FOR I = 1 TO 12
3350 LG = 0:PG = 0
3360  IF I / 3 =  INT (I / 3) THEN LG = 3:PG = 1
3370  IF I / 2 =  INT (I / 2) THEN LG = 5:PG = 2
3380  IF I / 6 =  INT (I / 6) THEN LG = 7:PG = 3
3390  LINE( XA + D * I * DG,YA - PG)-(  XA + D * I * DG,YA - PG + LG)
3400  NEXT I
3410  IF D = 1 THEN D =  - 1: GOTO 3340
3420  FOR I = 1 TO 5
3430 LG = 3:PG = 1
3440  IF (I / 5) =  INT (I / 5) THEN LG = 5:PG = 2
3450  LINE( XA - PG,YA - D * I * (L - 20) / 10 )-(XA - PG + LG,YA - D * I*(L-20)/10)
3460  NEXT I
3470  IF D =  - 1 THEN D = 1: GOTO 3420
3480  FOR I = 0 TO C
3490 P(I) = YA - A(0) * (L - 20) / 2
3500  NEXT I
3510 XD = XA - 12 * DG
3520 XF = XA + 12 * DG
3530 CX = 24 * DG
3540  IF AF(0) = 0 THEN 3560
3550  IF P(0) >= 0 AND P(0) < = L THEN  HPLOT XD, INT (P(0)) TO XF,INT(P(0))
3560  FOR I = 1 TO NB
3570 FL = 0
3580  IF AF(I) = 1 THEN FL = 1
3590  IF A(I) = 0 AND B(I) = 0 AND FL = 0 THEN 3690
3600 K = I * 2 * PI / CX:K1 =  - PI * I
3610 P(XD) = P(XD) - (L - 20) / 2 * (A(I) *  COS (K1) - B(I) *SIN (K1))
3620  FOR J = XD + 1 TO XF
3630 K2 = (J - XD) * K - K1
3640 P(J) = P(J) - (L - 20) / 2 * (A(I) *  COS (K2) + B(I) *  SIN (K2))
3650  IF FL = 0 THEN 3680
3660  IF P(J) < 0 OR P(J) > L OR P(J - 1) < 0 OR P(J - 1) > L THEN 3680
3670  LINE (J - 1, INT (P(J - 1)))-( J, INT (P(J))
3680  NEXT J
3690  NEXT I
3700  INPUT "VOLETE RIUTILIZZARE IL PROGRAMMA:";Z$
3710  SCREEN 0
3720  IF Z$ = "S" THEN 3000
3730  GOTO 100
4000  RUN "STARTUP"
