10 PRINT"INTRODURRE (PER ESEMPIO) 8, 8, 24"
20 INPUT ANGA
30 INPUT ANGB
40 INPUT LATO
50 KEY OFF
60 CLS
70 SCREEN 3
80 FOR I=0 TO 639
90 FOR J=0 TO 399
100 X=ANGA+(LATO*I/639)
110 Y=ANGB+(LATO*J/399)
120 NUM=ABS(SIN(X*X+Y*Y)*(X-Y))
130 DENOM=SIN(X+Y)+1
140 IF DENOM=0 THEN DENOM=1
150 Z=NUM/DENOM
160 C=INT(ABS(Z))
170 IF C/2=INT(C/2) THEN PSET(I,J)
180 NEXT:NEXT
190 A$=INPUT$(1)
200 SCREEN 0
