1 DEFDBL A,Z
10 CLS
20 KEY OFF
22 PRINT"INTRODURRE 10000 (O PIU': NUMERO ITERAZIONI), -3.14, 0.3, 0.3"
30 INPUT NUM
40 INPUT A
50 INPUT B
60 INPUT C
70 CLS
80 SCREEN 3
90 WINDOW(-14,-14)-(11,11)
100 VIEW(0,0)-(639,399)
110 FOR I=1 TO NUM
120 PSET(X,Y)
130 XX=Y-SGN(X)*SQR(ABS(B*X-C))
140 YY=A-X
150 X=XX
160 Y=YY
170 NEXT I
180 A$=INPUT$(1)
190 SCREEN 0,0,0
