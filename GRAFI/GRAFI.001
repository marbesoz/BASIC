10 PRINT"INTRODURRE (PER ESEMPIO) 8, 8, 24"
20 INPUT ANGA
30 INPUT ANGB
40 INPUT LATO
50 KEY OFF
60 CLS
70 SCREEN 3
80 FOR I=0 TO 639
90 FOR J=0 TO 399
100 X=ANGA+(LATO*I/639)
110 Y=ANGB+(LATO*J/399)
120 Z=X*X+Y*Y
130 C=INT(Z)
140 IF C/2=INT(C/2) THEN PSET(I,J)
150 NEXT:NEXT
160 A$=INPUT$(1)
170 SCREEN 0
