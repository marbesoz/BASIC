10 CLS
20 KEY OFF
30 PRINT"INTRODURRE 10000 (O PIU': NUMERO ITERAZIONI), -200, 0.1, -80"
40 INPUT NUM
50 INPUT A
60 INPUT B
70 INPUT C
80 CLS
90 SCREEN 3
100 WINDOW(-300,-250)-(100,50)
110 VIEW(0,0)-(639,399)
120 FOR I=1 TO NUM
130 PSET(X,Y)
140 XX=Y-SGN(X)*SQR(ABS(B*X-C))
150 YY=A-X
160 X=XX
170 Y=YY
180 NEXT I
190 A$=INPUT$(1)
200 SCREEN 0,0,0
