10 REM Per IBM cambiare SCREEN 3 a SCREEN 2 e 399 a 199
20 CLS
30 PRINT"Da 'LE SCIENZE', novembre 1987: uno strano attrattore, dal quale"
40 PRINT"pian piano emerge il caos."
50 PRINT
60 PRINT"UN TASTO PER VEDERE...";:A$=INPUT$(1)
70 SCREEN 2
80 X=.3
90 VERT=0
100 FOR R=2.9 TO 4 STEP 1.1/199
110 VERT=VERT+1
120 FOR I=1 TO 200
130 X=R*X*(1-X)
140 NEXT I
150 FOR I=1 TO 300
160 X=R*X*(1-X)
170 PSET(320*X,VERT)
180 NEXT I
190 NEXT R
200 A$=INPUT$(1)
210 SCREEN 0
