10 REM da 'Le Scienze' numero 187, marzo 1984
20 CLS
30 DEFDBL A-Z
40 PRINT"** HAILSTONES ** ( ovvero i numeri che rimbalzano come chicchi di grandine )"
50 PRINT
60 PRINT"Dato un numero intero e positivo, se e' pari lo si divide per due e se e' dispa-";
70 PRINT"ri lo si moltiplica per tre e si aggiunge 1 : dopo un certo numero di iterazioni";
80 PRINT"nel corso delle quali il vengono generati numeri che vanno su e giu' proprio co-";
90 PRINT"me fanno i chicchi di grandine, si ottiene SEMPRE 1 , qualunque sia il numero di";
100 PRINT"partenza. PROVARE PER CREDERE !!!!"
110 PRINT:PRINT:PRINT:PRINT
120 INPUT"DIMMI UN NUMERO INTERO E POSITIVO : ",NUMERO
130 PRINT
140 PRINT NUMERO,
150 IF NUMERO <=0 THEN GOTO 20
160 IF NUMERO <> INT(NUMERO) THEN GOTO 20
170 ITERAZIONI=0
180 MASSIMOVALORE=0
190 IF NUMERO=1 THEN GOTO 310
200 IF NUMERO/2 = INT(NUMERO/2)THEN GOTO 210 ELSE GOTO 260
210 NUMERO=NUMERO/2
220 PRINT NUMERO,
230 ITERAZIONI=ITERAZIONI+1
240 IF NUMERO>MASSIMOVALORE THEN MASSIMOVALORE=NUMERO
250 GOTO 190
260 NUMERO=NUMERO*3+1
270 PRINT NUMERO,
280 ITERAZIONI=ITERAZIONI+1
290 IF NUMERO>MASSIMOVALORE THEN MASSIMOVALORE=NUMERO
300 GOTO 190
310 PRINT
320 PRINT
330 PRINT"ITERAZIONI";ITERAZIONI
340 PRINT"MASSIMO VALORE RAGGIUNTO";MASSIMOVALORE
350 PRINT:PRINT:PRINT:PRINT
360 PRINT"(un tasto per continuare) ";:A$=INPUT$(1):GOTO 20
