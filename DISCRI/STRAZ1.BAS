10 DEFINT I,J,K,N
20 DEF FN FIL$(GRUPPO,V) = FIL$(V) +"." +CHR$(64+GRUPPO)
30 DIM FIL$(20)
40 CLS
45 '
46 PRINT "* SUPPORTO AL CALCOLO DELLA FUNZIONE DISCRIMINANTE *"
47  PRINT "*       (IMMISSIONE E MEMORIZZAZIONE DATI)         *"
48 PRINT :PRINT
49 '
50 PRINT"IL DISEGNO SPERIMENTALE RICHIEDE L'IMMISSIONE DI DUE GRUPPI DI DATI,"
55 PRINT"RELATIVI AI DUE GRUPPI DA DISCRIMINARE."
60 PRINT"OGNI GRUPPO PRESENTA UN CERTO NUMERO DI CASI; PER OGNI CASO BISOGNA"
70 PRINT"IMMETTERE I DATI RELATIVI ALLE VARIABILI FORMANTI OGGETTO D. ANALISI."
80 PRINT
90 PRINT "PER ESEMPIO: SI VOGLIONO DISCRIMINARE DUE GRUPPI (SANI E MALATI);"
100 PRINT "PER CIASCUN GRUPPO SI HANNO TOT CASI (N PAZIENTI E N CONTROLLI);"
110 PRINT "AD OGNI SOGGETTO SI E' MISURATO UN CERTO NUMERO DI PARAMETRI "
120 PRINT "EMATOCHIMICI (OGNI PARAMETRO E' UNA VARIABILE)."
140 PRINT
150 '
160 INPUT "QUANTE VARIABILI (DA 1 A 20) "; NV
180 IF NV<1 OR NV>20 THEN 160
190 '
200 PRINT: PRINT "IMPOSTARE IL NOME DEI FILE (MAX 8 CARATTERI)"
220 FOR I=1 TO NV
240   PRINT "PER LA VARIABILE"; I; ": ";: LINE INPUT FIL$(I)
260 NEXT
270 '
280 PRINT
300 PRINT "POICHE' OGNI VARIABILE VIENE MISURATA IN CIASCUN ELEMENTO DEI DUE GRUPPI, BISO- GNERA' SPECIFICARE "; 2*NV; "SERIE DI VALORI, PER I SEGUENTI FILES:"
310 FOR I=1 TO NV
320   PRINT FNFIL$(1,I), FNFIL$(2,I)
330 NEXT
340 '
350 PRINT
360 PRINT "NUMERO DI CASI IN STUDIO (UGUALE PER TUTTE LE SERIE) :";
370 INPUT NCASI
380 '
390 FOR GRUPPO =1 TO 2
400   PRINT :PRINT "GRUPPO "; CHR$(64+GRUPPO)
410   FOR VAR=1 TO NV
420     PRINT "VARIABILE N.";VAR;"(FILE ";;FNFIL$(GRUPPO,VAR); "):"
430     OPEN "O",1,FNFIL$(GRUPPO,VAR)
440     FOR I=1 TO NCASI
450       PRINT "CASO N.";I;": ";
460       INPUT X
470       PRINT #1, X
480     NEXT I
490     CLOSE 1
500   NEXT VAR
510 NEXT GRUPPO
520 '
600 PRINT
610 PRINT "** FINE IMMISSIONE **"
