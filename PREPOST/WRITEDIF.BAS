100 '(* begin listing writedif.bas *)
110 '
120 CLS
130 PRINT "Running WRITEDIF.BAS - reading data ... "
140 '
150 DATA  22,  33
160 DATA  23,  33
170 DATA 121, 234
180 DATA  23,  33
190 DATA   1,  23
200 DATA 232, 323
210 DATA  66, 121
220 DATA 234, 603
230 DATA  81,  99
240 DATA  23,  65
250 DATA  22,  33
260 DATA  33,  44
270 DATA  44,  11
280 DATA  55,  89
290 DATA 121, 212
300 DATA 111, 112
310 DATA  23,  90
320 DATA  55,  66
330 DATA  44, 123
340 DATA  55,  67
350 DATA  66,  42
360 DATA  24,  96
370 '
380 ON ERROR GOTO 810
390 '
400  NOBUG = -1
410    DUE = 2
420 COPPIE = -1
430 '
440 WHILE NOBUG
450  READ PRE,POST: COPPIE = COPPIE + 1
460 WEND
470 '
480 RESTORE 150
490 DIM DAT(DUE,COPPIE)
500 FOR I=1 TO COPPIE: READ DAT(1,I), DAT(2,I): NEXT
510 ON ERROR GOTO 0
520 '
530 PRINT: PRINT "There are " COPPIE " pairs - data are the following:"
540 FOR I=1 TO COPPIE: PRINT DAT(1,I) "," DAT(2,I)";",: NEXT: PRINT
550 '
560 PRINT: PRINT "INPUT FILENAME (omit extension '.DIF')";
570 INPUT NOMEFILE$
580 '
590 '(* SALVATAGGIO TABELLA DATI IN FORMATO DIF *)
600 PRINT "Writing ..."
610 '
620 V$ = CHR$(34)
630 OPEN NOMEFILE$+".DIF" FOR OUTPUT AS #1
640 PRINT #1, "TABLE"  : PRINT #1," 0, 1"     : PRINT #1, V$+NOMEFILE$+V$
650 PRINT #1, "VECTORS": PRINT #1," 0,";DUE   : PRINT #1, V$+V$
660 PRINT #1, "TUPLES" : PRINT #1," 0,";COPPIE: PRINT #1, V$+V$
670 PRINT #1, "DATA"   : PRINT #1," 0, 0"     : PRINT #1, V$+V$
680 FOR SET=1 TO DUE
690   PRINT #1, "-1, 0": PRINT #1, "BOT"
700   FOR PAIR=1 TO COPPIE
710     VALUE = DAT(SET,PAIR): ST$ = "V"
720     IF VALUE=0 OR VALUE=-999.99 THEN VALUE=0: ST$="NA"
730     PRINT #1, 0; ","; VALUE: PRINT #1, ST$
740   NEXT PAIR
750 NEXT SET
760 PRINT #1, "-1, 0": PRINT #1, "EOD"
770 CLOSE #1
780 '
790 PRINT "Done !" : END
800 '
810 IF ERR = 4  AND ERL = 450 THEN NOBUG=0: RESUME NEXT ELSE STOP
820 '
830 '(* end listing writedif.bas *)
