7500  IF  ABS (U) < PR THEN U = 0
7510  IF  ABS (P / 2) < PR THEN P = 0
7520  PRINT "L";CT;"="; - P / 2;"  +  ";U;"  I"
7530  PRINT "L";CT + 1;"="; - P / 2;"  -  ";U;"  I"
7540 N = N - 2:CT = CT + 2
7550  FOR I = 0 TO N:A(0,I) = B(0,I): NEXT I
7560  IF N > 2 GOTO 7200
7570  IF N = 2 THEN P = B(0,1):Q = B(0,2): GOTO 7400
7580  IF N < 1 GOTO 7620
7590 U =  - B(0,1) / B(0,0)
7600  IF  ABS (U) < PR THEN U = 0
7610  PRINT "L";CT;"=";U
