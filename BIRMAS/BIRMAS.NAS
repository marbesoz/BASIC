10 CLS
20 MX=100
30 DIM B(MX):DIM D(MX):DIM L(MX):DIM U(MX):DIM X(MX):DIM Y(MX)
40 PRINT"******  INTERPOLAZIONE MEDIANTE   ******"
50 PRINT"******      FUNZIONI SPLINE       ******"
60 PRINT"******     (SPLINE NATURALI)      ******"
70 PRINT
80 PRINT"1... Introduzione dei dati"
90 PRINT"2... Calcolo della y data la x"
100 PRINT
110 INPUT"Quale ";A$
120 A=VAL(A$)
130 ON A GOTO 160,550
140 PRINT
150 GOTO 40
160 REM
170 REM INTRODUZIONE DEI DATI
180 REM
190 GOSUB 770
200 Z1=0
210 I=1
220 PRINT"Punto numero ";I;" valore della x = ";
230 INPUT A$
240 IF A$="" THEN GOTO 350
250 X(I)=VAL(A$)
260 PRINT"Punto numero ";I;" valore della y = ";
270 INPUT A$
280 IF A$="" THEN GOTO 350
290 Y(I)=VAL(A$)
300 Z1=Z1+1
310 IF Z1=MX THEN GOTO 350
320 I=I+1
330 PRINT
340 GOTO 220
350 D(1)=1:U(1)=0:L(1)=0:B(1)=0
360 FOR I=2 TO Z1-1
370 D(I)=2*(X(I+1)-X(I-1))
380 U(I)=X(I+1)-X(I)
390 L(I)=U(I)
400 T=(Y(I+1)-Y(I))/U(I)
410 B(I)=6*(T-(Y(I)-Y(I-1))/(X(I)-X(I-1)))
420 NEXT I
430 D(Z1)=1:U(Z1-1)=0:L(Z1-1)=0:B(Z1)=0
440 FOR I=2 TO Z1
450 X=L(I-1)/D(I-1)
460 D(I)=D(I)-X*U(I-1)
470 B(I)=B(I)-X*B(I-1)
480 NEXT I
490 B(Z1)=B(Z1)/D(Z1)
500 FOR I=1 TO Z1-1
510 B(Z1-I)=(B(Z1-I)-U(Z1-I)*B(Z1-I+1))/D(Z1-I)
520 NEXT I
530 PRINT
540 GOTO 40
550 REM
560 REM CALCOLO DELLA Y DATA LA X
570 REM
580 GOSUB 770
590 PRINT"Valore della x                = ";
600 INPUT A$
610 IF A$="" THEN GOTO 750
620 X=VAL(A$)
630 J=1
640 I=Z1-J
650 IF X-X(I)>=0 THEN T=X-X(I):GOTO 680
660 J=J+1
670 GOTO 640
680 H=X(I+1)-X(I)
690 A=T*(B(I+1)-B(I))/6/H+B(I)/2
700 B=T*A+(Y(I+1)-Y(I))/H-H*(2*B(I)+B(I+1))/6
710 Y=T*B+Y(I)
720 PRINT"Corrispondente valore della y = ";Y
730 PRINT
740 GOTO 590
750 PRINT
760 GOTO 40
770 PRINT
780 PRINT"****************************************"
790 PRINT
800 RETURN
